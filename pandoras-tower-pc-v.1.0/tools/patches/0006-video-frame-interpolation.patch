+// the last frame drawn again at time t, from the state it started from;
+// the state of the frame coming in, part-way through maybe, put back after
+void interp_replay(float t) {
+    IFrame& b = *fr_last;
+    static uint32_t bp_now[0x100], xf_now[0x1058];
+    static uint64_t maps_now[8];
+    static int32_t reg_now[4][4], konst_now[4][4];
+    std::memcpy(bp_now, bp, sizeof bp);
+    std::memcpy(xf_now, xf, sizeof xf);
+    std::memcpy(maps_now, map_src, sizeof map_src);
+    std::memcpy(reg_now, tev_reg, sizeof tev_reg);
+    std::memcpy(konst_now, tev_konst, sizeof tev_konst);
+    std::memcpy(bp, b.bp0, sizeof bp);
+    std::memcpy(xf, b.xf0, sizeof xf);
+    std::memcpy(map_src, b.maps0, sizeof map_src);
+    std::memcpy(tev_reg, b.reg0, sizeof tev_reg);
+    std::memcpy(tev_konst, b.konst0, sizeof tev_konst);
+    xf_lo = 0;
+    xf_hi = 0x1058;
+    replaying = true;
+    rp_a = fr_prev && !b.cut ? fr_prev.get() : nullptr;
+    rp_b = &b;
+    rp_t = t;
+    rp_k = 0;
+    for (const auto& c : b.chunks) exec(c);
+    replaying = false;
+    std::memcpy(bp, bp_now, sizeof bp);
+    std::memcpy(xf, xf_now, sizeof xf);
+    std::memcpy(map_src, maps_now, sizeof map_src);
+    std::memcpy(tev_reg, reg_now, sizeof tev_reg);
+    std::memcpy(tev_konst, konst_now, sizeof tev_konst);
+    xf_lo = 0;
+    xf_hi = 0x1058;
+}
