 // ---- the window --------------------------------------------------------------------------------
+// A freeze, in run.err: a thread that watches both sides, the game (its frames
+// coming) and the renderer (its loop going round); one that stops for over
+// 1.5 seconds is written down, with what the renderer was doing, and again
+// when it goes on, with how long it was stopped
+static void watchdog() {
+    uint64_t lg = game_frames.load(), lv = video_loops.load();
+    auto tg = Clock::now(), tv = tg;
+    bool gs = false, vs = false;
+    int told = 0;
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        auto now = Clock::now();
+        uint64_t g = game_frames.load(), v = video_loops.load();
+        if (v != lv) {
+            if (vs && told < 40) { ++told; rt_log("freeze: the renderer went on after %.1f s", std::chrono::duration<double>(now - tv).count()); }
+            lv = v; tv = now; vs = false;
+        } else if (!vs && now - tv > std::chrono::milliseconds(1500)) {
+            vs = true;
+            if (told < 40) { ++told; rt_log("freeze: the renderer has been stopped 1.5 s, %s", v_doing.load()); }
+        }
+        if (g != lg) {
+            if (gs && told < 40) { ++told; rt_log("freeze: the game went on after %.1f s", std::chrono::duration<double>(now - tg).count()); }
+            lg = g; tg = now; gs = false;
+        } else if (!gs && !vs && now - tg > std::chrono::milliseconds(1500)) {
+            gs = true;                                        // the renderer runs: the game itself stopped
+            if (told < 40) { ++told; rt_log("freeze: the game has sent no frame for 1.5 s (the renderer is %s)", v_doing.load()); }
+        }
+    }
+}
