+// The pack's pictures are read by a thread of their own, so a big one (a UHD
+// DDS is megabytes) never holds the game up: until it is in, the game's own
+// texture shows, and the next time the game uses the texture it is swapped.
+// The pictures read stay while the most recently used fit in 512 MB.
+struct Loader {
+    std::mutex mx;
+    std::condition_variable cv;
+    std::deque<std::string> queue;
+    std::set<std::string> queued;
+    std::set<std::string> failed;                                     // unreadable: not asked for again
+    std::list<std::pair<std::string, std::shared_ptr<PackTex>>> lru;   // most recent first
+    size_t bytes = 0;
+    bool started = false;
+};
+Loader& loader() { static Loader* l = new Loader; return *l; }   // never destroyed: its thread waits to the end
+
+void loader_thread() {
+    Loader& l = loader();
+    for (;;) {
+        std::string path;
+        {
+            std::unique_lock<std::mutex> lk(l.mx);
+            l.cv.wait(lk, [&] { return !l.queue.empty(); });
+            path = l.queue.front();
+            l.queue.pop_front();
+        }
+        std::shared_ptr<PackTex> t = load_picture(path);
+        std::lock_guard<std::mutex> lk(l.mx);
+        l.queued.erase(path);
+        if (!t) { l.failed.insert(path); continue; }
+        static int told = 0;
+        if (told++ < 20) {
+            size_t cut = path.find_last_of("/\\");
+            rt_log("gx: %s replaced (%dx%d%s)", path.substr(cut == std::string::npos ? 0 : cut + 1).c_str(), t->w, t->h, t->glfmt ? ", compressed" : "");
+        }
+        l.lru.emplace_front(path, t);
+        l.bytes += t->rgba.size();
+        while (l.bytes > (512u << 20) && l.lru.size() > 1) { l.bytes -= l.lru.back().second->rgba.size(); l.lru.pop_back(); }
+    }
+}
+
+// the picture if it has been read; if not, it is asked for (and null)
+std::shared_ptr<PackTex> pack_ready(const std::string& path) {
+    Loader& l = loader();
+    std::lock_guard<std::mutex> lk(l.mx);
+    for (auto it = l.lru.begin(); it != l.lru.end(); ++it)
+        if (it->first == path) { l.lru.splice(l.lru.begin(), l.lru, it); return l.lru.front().second; }
+    if (l.failed.count(path)) return nullptr;
+    if (l.queued.insert(path).second) {
+        l.queue.push_back(path);
+        if (!l.started) { l.started = true; std::thread(loader_thread).detach(); }
+        l.cv.notify_one();
+    }
+    return nullptr;
+}
