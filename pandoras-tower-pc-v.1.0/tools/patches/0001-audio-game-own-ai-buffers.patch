         }
         case 0x0E: {                                 // OUTPUT: surround as 32-bit, L/R clamped, right then left
             uint32_t surround = next32(), lr = next32();
+            note_output(lr);
             upload(surround, mix[MS], NGC);
             uint32_t o = dsp_virt(lr);
             for (int i = 0; i < NGC; ++i) {
@@ -633,6 +645,12 @@ void gc_command_list(uint32_t addr) {
 
 }  // namespace
 
+bool ax_output_known() { return out_lr[0].load() != 0; }
+bool ax_is_output(uint32_t phys) {
+    uint32_t p = phys & 0x1FFFFFE0u;
+    return p == out_lr[0].load() || p == out_lr[1].load();
+}
