+void prescan(const std::vector<uint8_t>& data) {
+    if (!parallel_links) return;
+    static uint32_t pbp[0x100], pxf[0x1058];
+    std::memcpy(pbp, bp, sizeof pbp);
+    std::memcpy(pxf, xf, sizeof pxf);
+    const uint8_t* p = data.data();
+    const uint8_t* end = p + data.size();
+    while (p < end) {
+        switch (*p++) {
+        case VC_BP: { uint32_t v = rd<uint32_t>(p); pbp[v >> 24] = v & 0xFFFFFF; break; }
+        case VC_XF: {
+            uint16_t a = rd<uint16_t>(p), n = rd<uint16_t>(p);
+            std::memcpy(&pxf[a], p, 4u * n);
+            p += 4u * n;
+            break;
+        }
+        case VC_DRAW: {
+            uint8_t prim = rd<uint8_t>(p), fl = rd<uint8_t>(p);
+            uint32_t pieces = rd<uint32_t>(p);
+            for (uint32_t i = 0; i < pieces; ++i) { uint32_t n = rd<uint32_t>(p); p += (size_t)n * sizeof(GVtx); }
+            if (!(prim < 0xA8 && (pbp[0x00] >> 14 & 3) == 3)) prelink(pbp, pxf, fl);
+            break;
+        }
+        case VC_TEXUP: {
+            p += 1 + 4;
+            int w = rd<uint16_t>(p), h = rd<uint16_t>(p), levels = rd<uint8_t>(p);
+            for (int l = 0; l < levels; ++l) p += (size_t)std::max(1, w >> l) * std::max(1, h >> l) * 4;
+            break;
+        }
+        case VC_TEXUPC: {
+            p += 1 + 4 + 2 + 2;
+            int levels = rd<uint8_t>(p);
+            p += 4;
+            for (int l = 0; l < levels; ++l) { uint32_t size = rd<uint32_t>(p); p += size; }
+            break;
+        }
+        case VC_TEXBIND: case VC_TEXEFB: p += 1 + 4; break;
+        case VC_TEXFREE: p += 4; break;
+        case VC_FRAME: case VC_DRAWDONE: break;
+        default: return;                                           // exec says what is wrong
+        }
+    }
+}
