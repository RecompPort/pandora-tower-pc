+// The movies' bars (and, with no movie hint, any picture's): every second picture, five columns of it (at a tenth,
+// three tenths, the half...) are read back through a pixel buffer, without
+// waiting for them; a row is black where the five are. Bars are black rows at
+// the top and as many (give or take 2 % of the height) at the bottom, between
+// 6 % and 20 % of it each (a film's bars on 16:9 are about 12 %), with
+// something not black between them. A new height
+// is taken once three readings agree, and the picture changes to it at once. A
+// picture all black (a fade) changes nothing.
+// the bars' size in pixels along lines of `len` pixels each (RGBA, `lines` of
+// them one after another): black at both ends of every line, as much at one
+// end as at the other (give or take 2 %), between 6 % and 30 % of the length
+// each, something not black between them. 0 without bars, -1 all black.
+int bar_size(const uint8_t* px, int len, int lines) {
+    auto black = [&](int i) {
+        for (int l = 0; l < lines; ++l) {
+            const uint8_t* q = px + ((size_t)l * len + (size_t)i) * 4;
+            if (std::max({q[0], q[1], q[2]}) > 28) return false;
+        }
+        return true;
+    };
+    int lo = 0, hi = 0;
+    while (lo < len && black(lo)) ++lo;
+    if (lo == len) return -1;
+    while (hi < len - lo && black(len - 1 - hi)) ++hi;
+    int bar = std::min(lo, hi);
+    bool bars = bar >= len * 6 / 100 && bar <= len * 30 / 100 && std::abs(lo - hi) <= len * 2 / 100;
+    return bars ? bar : 0;
+}
+int letterbox_rows(const uint8_t* px, int rows, int kCols) { return bar_size(px, rows, kCols); }
+
+// The same for a movie's picture, from its two outermost lines only (at 5 % and
+// 95 %: subtitles or a logo drawn in a bar do not reach them), with a looser
+// black (a video's black is noisy), and the middle line not all black.
+// Writes what it saw to `why` for the log.
+int bar_size_edges(const uint8_t* px, int len, int lines, char* why, size_t whylen) {
+    auto dark = [&](int l, int i) {
+        const uint8_t* q = px + ((size_t)l * len + (size_t)i) * 4;
+        return std::max({q[0], q[1], q[2]}) <= 40;
+    };
+    auto run_lo = [&](int l) { int i = 0; while (i < len && dark(l, i)) ++i; return i; };
+    auto run_hi = [&](int l) { int i = 0; while (i < len && dark(l, len - 1 - i)) ++i; return i; };
+    int a_lo = run_lo(0), b_lo = run_lo(lines - 1), a_hi = run_hi(0), b_hi = run_hi(lines - 1);
+    int mid_lo = run_lo(lines / 2);
+    std::snprintf(why, whylen, "edges %d/%d and %d/%d of %d, middle %d", a_lo, a_hi, b_lo, b_hi, len, mid_lo);
+    if (mid_lo >= len) return -1;                                     // all black: a fade
+    int lo = std::min(a_lo, b_lo), hi = std::min(a_hi, b_hi);
+    int bar = std::min(lo, hi);
+    bool bars = bar >= len * 4 / 100 && bar <= len * 35 / 100 && std::abs(lo - hi) <= len * 3 / 100;
+    return bars ? bar : 0;
+}
+
+void find_letterbox(const Tex& t) {
+    // five columns (for the bars at the top and the bottom) and five rows (for
+    // those at the sides), at a tenth, three tenths, the half... of the picture
+    constexpr int kLines = 5;
+    static const int kAt[kLines] = {5, 25, 50, 75, 95};               // where, in % of the picture
+    static GLuint pbo = 0;
+    static bool movie_locked = false;                                 // a movie's bars, measured: kept to its end
+    static GLsync fence = nullptr;
+    static int W = 0, H = 0, frame = 0, seen_v = -1, seen_h = -1, agree = 0;
+    static float target_v = 0.0f, target_h = 0.0f;
+    auto read = [&](void* dst_or_offset) {                            // columns first, then rows
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, copy_fbo);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        char* base = (char*)dst_or_offset;
+        for (int c = 0; c < kLines; ++c)
+            glReadPixels(t.w * kAt[c] / 100, 0, 1, t.h, GL_RGBA, GL_UNSIGNED_BYTE, base + (size_t)c * t.h * 4);
+        char* rows = base + (size_t)kLines * t.h * 4;
+        for (int r = 0; r < kLines; ++r)
+            glReadPixels(0, t.h * kAt[r] / 100, t.w, 1, GL_RGBA, GL_UNSIGNED_BYTE, rows + (size_t)r * t.w * 4);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    };
+    auto measure = [&](const uint8_t* px, int w, int h, int& v, int& hz) {
+        v = bar_size(px, h, kLines);
+        hz = bar_size(px + (size_t)kLines * h * 4, w, kLines);
+    };
+    static bool told = false;
+    if (!told) {
+        told = true;
+        rt_log("video: black bars: looked for %s (a movie's first picture measured before it shows)",
+               movie_hint.load() == -1 ? "in every picture" : "in the movies");
+    }
+    auto report = [&](const char* where) {                            // the first changes, to the log
+        static int n = 0;
+        if (n++ < 12) rt_log("video: black bars cut (%s): top and bottom %.1f%%, sides %.1f%%", where, target_v * 100, target_h * 100);
+    };
+    int hint = movie_hint.load();
+    if (movie_ended.exchange(false)) {                                // the movie is over: back to the whole picture
+        target_v = target_h = 0.0f; seen_v = seen_h = -1; agree = 0;
+        movie_locked = false;
+    }
+    if (hint == 0) {
+        // the game layer tells the movies, and keeps the game's own bars from
+        // being drawn: outside a movie there is nothing to look for (a dark
+        // scene is not taken for bars)
+        target_v = target_h = 0.0f;
+        letterbox.store(0.0f);
+        pillarbox.store(0.0f);
+        return;
+    }
+    if (hint == 1 && movie_fresh.load()) {
+        // a movie has just begun: read this very picture (waiting for it), and
+        // cut its bars before it is shown; while it is all black, nothing shows
+        std::vector<uint8_t> px((size_t)kLines * (t.h + t.w) * 4);
+        read(px.data());
+        char why_v[96], why_h[96];
+        int v = bar_size_edges(px.data(), t.h, kLines, why_v, sizeof why_v);
+        int hz = bar_size_edges(px.data() + (size_t)kLines * t.h * 4, t.w, kLines, why_h, sizeof why_h);
+        if (v >= 0 && hz >= 0) {
+            static int n = 0;
+            if (n++ < 20) rt_log("video: movie measured: rows (%s) -> %d, columns (%s) -> %d", why_v, v, why_h, hz);
+            movie_locked = true;
+            target_v = (float)v / (float)t.h;
+            target_h = (float)hz / (float)t.w;
+            seen_v = v; seen_h = hz; agree = 3;
+            letterbox.store(target_v);
+            pillarbox.store(target_h);
+            movie_fresh.store(false);
+            report("movie");
+        }
+        return;
+    }
+    if (hint == 1 && movie_locked) return;                            // the movie's crop stays as it is
+    if (fence) {
+        GLenum st = glClientWaitSync(fence, 0, 0);
+        if (st == GL_ALREADY_SIGNALED || st == GL_CONDITION_SATISFIED) {
+            glDeleteSync(fence);
+            fence = nullptr;
+            const uint8_t* px = (const uint8_t*)glMapNamedBufferRange(pbo, 0, (GLsizeiptr)kLines * (H + W) * 4, GL_MAP_READ_BIT);
+            if (px) {
+                int v, hz;
+                measure(px, W, H, v, hz);
+                glUnmapNamedBuffer(pbo);
+                if (v >= 0 && hz >= 0) {                              // not a fade to black
+                    if (std::abs(v - seen_v) <= H / 200 && std::abs(hz - seen_h) <= W / 200) ++agree;
+                    else { seen_v = v; seen_h = hz; agree = 1; }
+                    if (agree >= 3) {
+                        float nv = (float)seen_v / (float)H, nh = (float)seen_h / (float)W;
+                        bool changed = std::fabs(nv - target_v) > 0.004f || std::fabs(nh - target_h) > 0.004f;
+                        target_v = nv; target_h = nh;
+                        if (changed) report(hint == 1 ? "movie" : "picture");
+                    }
+                }
+            }
+        }
+    }
+    letterbox.store(target_v);                                        // at once, no transition
+    pillarbox.store(target_h);
+    if (fence || ++frame % 2) return;
+    if (H != t.h || W != t.w || !pbo) {
+        if (pbo) glDeleteBuffers(1, &pbo);
+        glCreateBuffers(1, &pbo);
+        glNamedBufferStorage(pbo, (GLsizeiptr)kLines * (t.h + t.w) * 4, nullptr, GL_MAP_READ_BIT);
+        H = t.h;
+        W = t.w;
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo);
+    read(nullptr);                                                    // into the buffer, from offset 0
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+}
+
+}  // namespace
+
+void video_letterbox_hint(int movie) {
+    movie_hint.store(movie ? 1 : 0);
+    if (movie) movie_fresh.store(true);
+    else { movie_ended.store(true); letterbox.store(0.0f); pillarbox.store(0.0f); }
+}
