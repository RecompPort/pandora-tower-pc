+// a DDS of a texture pack: BC1 (DXT1), BC2 (DXT3), BC3 (DXT5) or BC7, with its
+// mipmaps, kept compressed for the GPU; or 32-bit uncompressed, made RGBA8
+std::shared_ptr<PackTex> load_dds(const std::string& path) {
+    std::vector<uint8_t> f;
+    if (FILE* fp = std::fopen(path.c_str(), "rb")) {
+        uint8_t buf[65536];
+        size_t n;
+        while ((n = std::fread(buf, 1, sizeof buf, fp)) > 0) f.insert(f.end(), buf, buf + n);
+        std::fclose(fp);
+    }
+    auto u32 = [&](size_t o) { uint32_t v = 0; if (o + 4 <= f.size()) std::memcpy(&v, &f[o], 4); return v; };
+    if (f.size() < 128 || std::memcmp(f.data(), "DDS ", 4) != 0) return nullptr;
+    int h = (int)u32(12), w = (int)u32(16);
+    uint32_t flags = u32(8), mips = (flags & 0x20000) ? std::max(1u, u32(28)) : 1u;
+    uint32_t pf_flags = u32(80), fourcc = u32(84), bits = u32(88);
+    size_t data = 128;
+    uint32_t glfmt = 0, block = 0;
+    auto cc = [](const char* s) { return (uint32_t)s[0] | (uint32_t)s[1] << 8 | (uint32_t)s[2] << 16 | (uint32_t)s[3] << 24; };
+    if (pf_flags & 4) {                                     // a FourCC
+        if (fourcc == cc("DXT1")) { glfmt = 0x83F1; block = 8; }
+        else if (fourcc == cc("DXT3")) { glfmt = 0x83F2; block = 16; }
+        else if (fourcc == cc("DXT5")) { glfmt = 0x83F3; block = 16; }
+        else if (fourcc == cc("DX10")) {
+            uint32_t dxgi = u32(128);
+            data = 148;
+            if (dxgi == 71 || dxgi == 72) { glfmt = 0x83F1; block = 8; }
+            else if (dxgi == 74 || dxgi == 75) { glfmt = 0x83F2; block = 16; }
+            else if (dxgi == 77 || dxgi == 78) { glfmt = 0x83F3; block = 16; }
+            else if (dxgi == 98 || dxgi == 99) { glfmt = 0x8E8C; block = 16; }      // BC7 (the sRGB one too, as Dolphin)
+            else if (dxgi == 28 || dxgi == 29) { bits = 32; pf_flags = 0x41; }     // RGBA8
+            else if (dxgi == 87 || dxgi == 91) { bits = 32; pf_flags = 0x41 | 0x80000000u; }   // BGRA8
+        }
+    }
+    if (w <= 0 || h <= 0 || w > 8192 || h > 8192) return nullptr;
+    auto t = std::make_shared<PackTex>();
+    t->w = w; t->h = h;
+    if (glfmt) {
+        size_t at = data;
+        for (uint32_t l = 0; l < mips && l < 16; ++l) {
+            size_t lw = std::max(1, w >> l), lh = std::max(1, h >> l);
+            size_t size = ((lw + 3) / 4) * ((lh + 3) / 4) * block;
+            if (at + size > f.size()) break;
+            t->sizes.push_back((uint32_t)size);
+            at += size;
+        }
+        if (t->sizes.empty()) return nullptr;
+        t->glfmt = glfmt;
+        t->rgba.assign(f.begin() + (std::ptrdiff_t)data, f.begin() + (std::ptrdiff_t)(data + (at - data)));
+        return t;
+    }
+    if ((pf_flags & 0x40) && bits == 32 && data + (size_t)w * h * 4 <= f.size()) {   // uncompressed 32-bit
+        bool bgra = (pf_flags & 0x80000000u) || u32(92) == 0x00FF0000u;
+        t->rgba.assign(f.begin() + (std::ptrdiff_t)data, f.begin() + (std::ptrdiff_t)(data + (size_t)w * h * 4));
+        if (bgra) for (size_t i = 0; i < t->rgba.size(); i += 4) std::swap(t->rgba[i], t->rgba[i + 2]);
+        if (!(u32(80) & 1) && !(pf_flags & 1)) for (size_t i = 3; i < t->rgba.size(); i += 4) t->rgba[i] = 255;
+        return t;
+    }
+    return nullptr;
+}
