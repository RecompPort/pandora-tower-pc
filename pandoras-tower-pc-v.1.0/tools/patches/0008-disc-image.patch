+
+// a file beside the partition's payload, as wiikit.disc --extract writes it
+std::vector<uint8_t> disc_sysfile(const char* rel) {
+    std::string r = rel;
+    if (!g_is_image) return slurp(g_root + "/" + r);
+    if (r == "sys/boot.bin") return g_boot;
+    if (r == "sys/fst.bin") return g_fst;
+    if (r == "sys/bi2.bin") return image_part(0x440, 0x2000);
+    if (r == "ticket.bin") return g_img.ticket;
+    if (r == "tmd.bin") return g_img.tmd;
+    if (r == "disc/region.bin") return g_img.region;
+    if (r == "sys/main.dol") {
+        uint64_t dol = (uint64_t)be32(&g_boot[0x420]) << g_shift;
+        std::vector<uint8_t> h = image_part(dol, 0x100);
+        uint64_t end = 0x100;
+        for (int i = 0; i < 18; ++i) end = std::max<uint64_t>(end, (uint64_t)be32(&h[i * 4]) + be32(&h[0x90 + i * 4]));
+        return image_part(dol, (size_t)end);
+    }
+    return {};
+}
+
+bool disc_is_image() { return g_is_image; }
+
+// WIIKIT_DISC_CHECK=FOLDER: every file of the image, and its system files,
+// read through this reader and compared with the same files extracted (by
+// Dolphin's "Extract Entire Disc", or wiikit.disc --extract) in FOLDER.
+int disc_check(const char* folder) {
+    if (!g_is_image) { rt_log("check: not reading an image"); return 1; }
+    std::string root = folder;
+    size_t files = 0, differ = 0, missing = 0;
+    uint64_t bytes = 0;
+    std::vector<uint8_t> a(1 << 20), b(1 << 20);
+    auto compare = [&](const std::string& label, const std::vector<uint8_t>& mine, const std::string& path) {
+        std::vector<uint8_t> theirs = slurp(path);
+        if (theirs.empty()) { rt_log("check: %s: not in the folder", label.c_str()); ++missing; return; }
+        size_t n = std::min(mine.size(), theirs.size());
+        size_t at = 0;
+        while (at < n && mine[at] == theirs[at]) ++at;
+        if (at < n || mine.size() < theirs.size()) { rt_log("check: %s differs at %zX (%zu vs %zu bytes)", label.c_str(), at, mine.size(), theirs.size()); ++differ; }
+    };
+    compare("sys/boot.bin", disc_sysfile("sys/boot.bin"), root + "/sys/boot.bin");
+    compare("sys/bi2.bin", disc_sysfile("sys/bi2.bin"), root + "/sys/bi2.bin");
+    compare("sys/fst.bin", disc_sysfile("sys/fst.bin"), root + "/sys/fst.bin");
+    compare("sys/main.dol", disc_sysfile("sys/main.dol"), root + "/sys/main.dol");
+    compare("tmd.bin", disc_sysfile("tmd.bin"), root + "/tmd.bin");
+    compare("ticket.bin", disc_sysfile("ticket.bin"), root + "/ticket.bin");
+    for (const Named& r : g_named) {
+        FILE* f = std::fopen((root + "/files/" + r.name).c_str(), "rb");
+        if (!f) { rt_log("check: files/%s: not in the folder", r.name.c_str()); ++missing; continue; }
+        bool same = true;
+        for (uint64_t done = 0; done < r.size && same;) {
+            size_t n = (size_t)std::min<uint64_t>(a.size(), r.size - done);
+            image_read(r.off + done, a.data(), n);
+            if (std::fread(b.data(), 1, n, f) != n || std::memcmp(a.data(), b.data(), n)) {
+                size_t at = 0;
+                while (at < n && a[at] == b[at]) ++at;
+                rt_log("check: files/%s differs at %llX", r.name.c_str(), (unsigned long long)(done + at));
+                same = false;
+            }
+            done += n;
+            bytes += n;
+        }
+        std::fclose(f);
+        ++files;
+        if (!same) ++differ;
+        if (files % 250 == 0) rt_log("check: %zu of %zu files...", files, g_named.size());
+    }
+    rt_log("check: %zu files and the system files, %.2f GB: %zu differ, %zu missing", files, bytes / 1e9, differ, missing);
+    return (int)(differ + missing);
+}
