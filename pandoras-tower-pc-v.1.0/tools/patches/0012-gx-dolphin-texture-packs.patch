+std::shared_ptr<PackTex> pack_load(const std::string& path, const std::string& label) {
+    static std::list<std::pair<std::string, std::shared_ptr<PackTex>>> lru;     // most recent first
+    static size_t bytes = 0;
+    for (auto it = lru.begin(); it != lru.end(); ++it)
+        if (it->first == path) { lru.splice(lru.begin(), lru, it); return lru.front().second; }
+    int w = 0, h = 0, n = 0;
+    unsigned char* px = stbi_load(path.c_str(), &w, &h, &n, 4);
+    if (!px) { rt_log("gx: %s: not a PNG it can read", path.c_str()); return nullptr; }
+    std::shared_ptr<PackTex> t;
+    if (w > 0 && h > 0 && w <= 8192 && h <= 8192) {
+        t = std::make_shared<PackTex>(PackTex{w, h, std::vector<uint8_t>(px, px + (size_t)w * h * 4)});
+        static int told = 0;
+        if (told++ < 20) rt_log("gx: %s replaced (%dx%d)", label.c_str(), w, h);
+    }
+    stbi_image_free(px);
+    if (!t) return nullptr;
+    lru.emplace_front(path, t);
+    bytes += t->rgba.size();
+    while (bytes > (512u << 20) && lru.size() > 1) { bytes -= lru.back().second->rgba.size(); lru.pop_back(); }
+    return t;
+}
