+// a texture's name in Dolphin's packs: tex1_WxH[_m]_TEXHASH[_TLUTHASH]_FORMAT, the
+// hashes XXH64 of the first level's bytes and of the part of the palette the
+// texture uses (its lowest to highest index); with "$" in place of the palette's
+// hash, a pack's file serves any palette
+std::string dolphin_name(uint32_t fmt, int w, int h, bool mips, const uint8_t* src, const uint8_t* pal, bool wildcard) {
+    size_t size = gxtex_size(fmt, w, h);
+    char b[96];
+    int n = std::snprintf(b, sizeof b, "tex1_%dx%d%s_%016llx", w, h, mips ? "_m" : "", (unsigned long long)xxh64(src, size));
+    if (pal && gxtex_is_ci(fmt)) {
+        uint32_t lo = 0xFFFF, hi = 0, entries = gxtex_ci_entries(fmt);
+        if (entries == 16)
+            for (size_t i = 0; i < size; ++i) { lo = std::min({lo, (uint32_t)(src[i] & 15), (uint32_t)(src[i] >> 4)}); hi = std::max({hi, (uint32_t)(src[i] & 15), (uint32_t)(src[i] >> 4)}); }
+        else if (entries == 256)
+            for (size_t i = 0; i < size; ++i) { lo = std::min(lo, (uint32_t)src[i]); hi = std::max(hi, (uint32_t)src[i]); }
+        else
+            for (size_t i = 0; i + 1 < size; i += 2) { uint32_t v = (src[i] << 8 | src[i + 1]) & 0x3FFF; lo = std::min(lo, v); hi = std::max(hi, v); }
