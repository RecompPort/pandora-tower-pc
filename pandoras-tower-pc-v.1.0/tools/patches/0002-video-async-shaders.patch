+// link() without waiting: no status is asked for, as each query would wait
+// for the driver's threads; the program's GL_COMPLETION_STATUS_KHR tells
+// when it is done (poll_pending)
+GLuint link_async(const std::string& vs, const std::string& fs) {
+    GLuint v = glCreateShader(GL_VERTEX_SHADER), f = glCreateShader(GL_FRAGMENT_SHADER);
+    const char* pv = vs.c_str();
+    const char* pf = fs.c_str();
+    glShaderSource(v, 1, &pv, nullptr);
+    glShaderSource(f, 1, &pf, nullptr);
+    glCompileShader(v);
+    glCompileShader(f);
+    GLuint p = glCreateProgram();
+    glAttachShader(p, v);
+    glAttachShader(p, f);
+    glProgramParameteri(p, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);   // for the shader cache
+    glLinkProgram(p);
+    glDeleteShader(v);                                 // freed with the program
+    glDeleteShader(f);
+    return p;
+}
