+// A program being linked asynchronously: once the driver is done, it joins
+// the programs (and the cache); until then, false (its draws are skipped).
+// A link that failed gives program 0, as link() does.
+bool poll_pending(const std::string& source, GLuint& out) {
+    auto q = pending_by_source.find(source);
+    if (q == pending_by_source.end()) { out = programs_by_source[source]; return true; }
+    GLint done = 0;
+    glGetProgramiv(q->second.p, GL_COMPLETION_STATUS_KHR, &done);
+    if (!done) return false;
+    GLuint p = q->second.p;
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (ok) { ++cnt.linked; save_program(p, q->second.hash); }
+    else {
+        char log[4096];
+        glGetProgramInfoLog(p, sizeof log, nullptr, log);
+        rt_log("video: program does not link: %s", log);
+        glDeleteProgram(p);
+        p = 0;
+    }
+    programs_by_source[source] = p;
+    pending_by_source.erase(q);
+    out = p;
+    return true;
+}
