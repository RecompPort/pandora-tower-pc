+// ---- frame interpolation, phase 1: a diagnostic (WIIKIT_INTERP_DIAG=1) ---------------------------
+// Drawing frames between the game's own means pairing each draw of a frame
+// with the same draw in the frame before and interpolating what moved. This
+// measures, before any of that is written, how well a game's frames pair: a
+// draw's key is its primitive, vertex count, textures and TEV setup; for each
+// pair it notes whether the model-space vertices are the same (the motion is
+// in the matrices, the easy case) and whether its position matrix or the
+// projection changed (something to interpolate). Every 300 frames, one line.
+struct DrawSig { uint64_t key, verts, xfm; };
+bool interp_diag = false;
+std::vector<DrawSig> sig_prev, sig_cur;
+struct InterpStats { uint64_t frames, draws, paired, same_verts, moved, cuts; } istat = {};
+
+uint64_t mix64(uint64_t h, uint64_t v) {
+    h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    return h * 0xFF51AFD7ED558CCDull;
+}
+uint64_t hash_bytes(const uint8_t* p, size_t n, uint64_t h) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) { uint64_t w; std::memcpy(&w, p + i, 8); h = mix64(h, w); }
+    for (; i < n; ++i) h = mix64(h, p[i]);
+    return h;
+}
+
+void interp_note(uint8_t prim, uint8_t fl, uint32_t pieces, const uint8_t* q) {
+    uint64_t count = 0, vh = 1;
+    int pm = -1;
+    for (uint32_t i = 0; i < pieces; ++i) {
+        uint32_t n;
+        std::memcpy(&n, q, 4);
+        q += 4;
+        if (pm < 0 && n) pm = q[offsetof(GVtx, mtx)] & 63;    // the first vertex's position matrix
+        vh = hash_bytes(q, (size_t)n * sizeof(GVtx), vh);
+        q += (size_t)n * sizeof(GVtx);
+        count += n;
+    }
+    uint64_t key = mix64(mix64(mix64(prim, fl), count), bp[0x00]);
+    for (int m = 0; m < 8; ++m) key = mix64(key, map_src[m]);
+    for (int r = 0x28; r < 0x30; ++r) key = mix64(key, bp[r]);         // TEV orders
+    uint64_t xh = hash_bytes(reinterpret_cast<const uint8_t*>(&xf[0x1020]), 7 * 4, 2);
+    if (pm >= 0) xh = hash_bytes(reinterpret_cast<const uint8_t*>(&xf[pm * 4]), 12 * 4, xh);
+    sig_cur.push_back(DrawSig{key, vh, xh});
+}
+
+void interp_frame() {
+    if (!sig_prev.empty()) {
+        std::unordered_map<uint64_t, std::vector<size_t>> by_key;     // the previous frame's draws, in order
+        for (size_t i = sig_prev.size(); i-- > 0;) by_key[sig_prev[i].key].push_back(i);
+        uint64_t paired = 0, same = 0, moved = 0;
+        for (const DrawSig& s : sig_cur) {
+            auto it = by_key.find(s.key);
+            if (it == by_key.end() || it->second.empty()) continue;
+            const DrawSig& q = sig_prev[it->second.back()];
+            it->second.pop_back();
+            ++paired;
+            if (q.verts == s.verts) ++same;
+            if (q.xfm != s.xfm) ++moved;
+        }
+        ++istat.frames;
+        istat.draws += sig_cur.size();
+        istat.paired += paired;
+        istat.same_verts += same;
+        istat.moved += moved;
+        if (paired * 2 < sig_cur.size()) ++istat.cuts;
+        if (istat.frames >= 300) {
+            double d = (double)std::max<uint64_t>(istat.draws, 1), pr = (double)std::max<uint64_t>(istat.paired, 1);
+            rt_log("interp: %llu frames, %.0f draws a frame; paired %.1f%%; of the pairs, same vertices %.1f%%, moved %.1f%%; frames under half paired: %llu",
+                   (unsigned long long)istat.frames, d / istat.frames, 100.0 * istat.paired / d,
+                   100.0 * istat.same_verts / pr, 100.0 * istat.moved / pr, (unsigned long long)istat.cuts);
+            istat = InterpStats{};
+        }
+    }
+    std::swap(sig_prev, sig_cur);
+    sig_cur.clear();
+}
+
