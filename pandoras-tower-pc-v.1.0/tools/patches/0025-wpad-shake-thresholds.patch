+constexpr double kShakeHz = 4.0;
+
+// a shake's swing (-1..1) at this moment: a cosine from its start, so that its
+// first sample is already a full swing, and from then on four a second
+struct Swing {
+    bool on = false;
+    std::chrono::steady_clock::time_point t0;
+    float at(bool shaken) {
+        auto now = std::chrono::steady_clock::now();
+        if (!shaken) { on = false; return 0; }
+        if (!on) { on = true; t0 = now; }
+        double t = std::chrono::duration<double>(now - t0).count();
+        return (float)std::cos(2 * 3.14159265358979 * kShakeHz * t);
+    }
+};
+Swing remote_swing[4], nunchuk_swing[4];
