+// the bars of the movies measured before (this game's are all alike): kept in
+// the shader cache's folder, so a movie that begins dark (a fade in, before it
+// can be measured) already starts with them cut
+struct MovieBars { float v = -1, h = -1; };
+MovieBars& movie_bars() {
+    static MovieBars b = [] {
+        MovieBars r;
+        if (!opt.shader_cache.empty())
+            if (FILE* f = std::fopen((opt.shader_cache + "/movie-bars.txt").c_str(), "r")) {
+                if (std::fscanf(f, "%f %f", &r.v, &r.h) != 2) r.v = r.h = -1;
+                std::fclose(f);
+            }
+        return r;
+    }();
+    return b;
+}
+void remember_movie_bars(float v, float h) {
+    MovieBars& b = movie_bars();
+    if (std::fabs(b.v - v) < 0.002f && std::fabs(b.h - h) < 0.002f) return;
+    b.v = v; b.h = h;
+    if (opt.shader_cache.empty()) return;
+    std::error_code ec;
+    std::filesystem::create_directories(opt.shader_cache, ec);
+    if (FILE* f = std::fopen((opt.shader_cache + "/movie-bars.txt").c_str(), "w")) { std::fprintf(f, "%.4f %.4f\n", v, h); std::fclose(f); }
+}
