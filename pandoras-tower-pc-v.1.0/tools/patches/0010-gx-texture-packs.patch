+// ---- texture dumps and packs -------------------------------------------------------------------
+// WIIKIT_TEXTURE_DUMP=FOLDER: each texture the game uploads, once, as FOLDER/<name>.png (its
+// first level). WIIKIT_TEXTURE_PACK=FOLDER[;FOLDER...]: FOLDER/<name>.png replaces the game's
+// texture of that name, at any size (a bigger picture is a sharper one; its mipmaps are made
+// here when the game's texture has some); the first folder with the name wins. <name> is the
+// texture's size, format and a hash of its first level's bytes and palette, so it does not
+// depend on where in memory the game keeps it.
+struct PackTex { int w, h; std::vector<uint8_t> rgba; };
+
+std::string tex_name(uint32_t fmt, int w, int h, const uint8_t* src, uint64_t th) {
+    uint64_t hh = hash_mem(src, gxtex_size(fmt, w, h)) ^ (th * 0x9E3779B97F4A7C15ull);
+    char b[64];
+    std::snprintf(b, sizeof b, "%dx%d_f%u_%016llx", w, h, fmt, (unsigned long long)hh);
+    return b;
+}
+
+const PackTex* pack_lookup(const std::string& name) {
+    static std::vector<std::string> dirs = [] {
+        std::vector<std::string> d;
+        if (const char* e = std::getenv("WIIKIT_TEXTURE_PACK"))
+            for (std::string all = e; !all.empty();) {
+                size_t k = all.find(';');
+                std::string one = all.substr(0, k);
+                if (!one.empty()) d.push_back(one);
+                all = k == std::string::npos ? "" : all.substr(k + 1);
+            }
+        for (auto& x : d) rt_log("gx: texture pack %s", x.c_str());
+        return d;
+    }();
+    static std::unordered_map<std::string, std::unique_ptr<PackTex>> cache;    // null: not in any pack
+    if (dirs.empty()) return nullptr;
+    auto it = cache.find(name);
+    if (it != cache.end()) return it->second.get();
+    std::unique_ptr<PackTex> t;
+    for (const std::string& d : dirs) {
+        int w = 0, h = 0, n = 0;
+        unsigned char* px = stbi_load((d + "/" + name + ".png").c_str(), &w, &h, &n, 4);
+        if (!px) continue;
+        if (w > 0 && h > 0 && w <= 8192 && h <= 8192) {
+            t.reset(new PackTex{w, h, std::vector<uint8_t>(px, px + (size_t)w * h * 4)});
+            static int told = 0;
+            if (told++ < 20) rt_log("gx: %s replaced (%dx%d)", name.c_str(), w, h);
+        }
+        stbi_image_free(px);
+        break;
+    }
+    const PackTex* r = t.get();
+    cache.emplace(name, std::move(t));
+    return r;
+}
+
+// half of an RGBA picture, each pixel the average of four (premultiplied by their alpha)
+void half(const uint8_t* s, int w, int h, uint8_t* d) {
+    int nw = std::max(1, w >> 1), nh = std::max(1, h >> 1);
+    for (int y = 0; y < nh; ++y)
+        for (int x = 0; x < nw; ++x) {
+            uint32_t acc[4] = {}, a = 0;
+            for (int dy = 0; dy < 2; ++dy)
+                for (int dx = 0; dx < 2; ++dx) {
+                    const uint8_t* q = s + ((size_t)std::min(h - 1, y * 2 + dy) * w + std::min(w - 1, x * 2 + dx)) * 4;
+                    for (int c = 0; c < 3; ++c) acc[c] += q[c] * q[3];
+                    a += q[3];
+                }
+            uint8_t* o = d + ((size_t)y * nw + x) * 4;
+            for (int c = 0; c < 3; ++c) o[c] = (uint8_t)(a ? acc[c] / a : 0);
+            o[3] = (uint8_t)((a + 2) / 4);
+        }
+}
