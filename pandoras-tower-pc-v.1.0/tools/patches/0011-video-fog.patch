+        else
+            s += "        float ze = (u_fog.x * 16777216.0) / float(u_fogi.y - (zs >> u_fogi.w));\n";
+        s += "        float f = clamp(ze - u_fog.y, 0.0, 1.0);\n";
+        switch (fsel) {
+        case 4: s += "        f = 1.0 - exp2(-8.0 * f);\n"; break;                 // exponential
+        case 5: s += "        f = 1.0 - exp2(-8.0 * f * f);\n"; break;             // exponential squared
+        case 6: s += "        f = exp2(-8.0 * (1.0 - f));\n"; break;               // reverse exponential
+        case 7: s += "        f = exp2(-8.0 * (1.0 - f) * (1.0 - f));\n"; break;   // reverse exponential squared
+        default: break;                                                            // linear
+        }
+        s += "        int fi = int(round(f * 256.0));\n";
+        s += "        fin.rgb = (fin.rgb * (256 - fi) + u_fogcol.rgb * fi) >> 8;\n    }\n";
+    }
     s += "    o_blend = vec4(fin) / 255.0;\n    o_col = o_blend;\n";
     if (bp[0x42] >> 8 & 1) s += "    o_col.a = float(u_alpha.z) / 255.0;\n";
     s += "}\n";
