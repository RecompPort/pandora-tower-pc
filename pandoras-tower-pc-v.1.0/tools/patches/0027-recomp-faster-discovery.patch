+class _Walker:
+    """Step 2 on a slice of the sorted starts, with the per-address facts it
+    needs looked up once."""
+
+    def __init__(self, code):
+        self.code = code
+        self.seg = {}
+        self.last = {}
+
+    def seg_end(self, s):
+        e = self.seg.get(s)
+        if e is None:
+            e = self.seg[s] = self.code.segment_end(s)
+        return e
+
+    def last_code(self, end, s):
+        """The last code word before `end`, or one below `s` if none from s."""
+        a = end - 4
+        code = self.code
+        while a >= s and not code.is_code(a):
+            a -= 4
+        return a
+
+    def units(self, starts, lo, hi):
+        """Units of starts[lo:hi]: each runs to the next start it does not fall
+        through into; the last of the slice ends where the slice's last unit
+        ended (a cut, or its segment's end)."""
+        code = self.code
+        units, inner = [], set()
