// Recursos de Windows del instalador: icono, manifiesto (sin pedir administrador) y versión.
// compilar.sh lo pasa por llvm-rc/windres; la versión la pone él (-D VER=..., VERS=...).
#ifndef VER
#define VER 1,0,0,0
#define VERS "1.0"
#endif
1 ICON "../lanzador/pandora.ico"
1 24 "instalador.manifest"
1 VERSIONINFO
FILEVERSION VER
PRODUCTVERSION VER
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "RecompPort (fan project)"
      VALUE "FileDescription", "Pandora's Tower PC port - setup"
      VALUE "FileVersion", VERS
      VALUE "InternalName", "Instalador"
      VALUE "LegalCopyright", "MIT license. Contains no game files."
      VALUE "OriginalFilename", "PandorasTower-PC-Setup.exe"
      VALUE "ProductName", "Pandora's Tower PC port"
      VALUE "ProductVersion", VERS
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
